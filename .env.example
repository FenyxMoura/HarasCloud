# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE: HARAS CLOUD EM PRODUÇÃO
# ==============================================================================

# 1. BANCO DE DADOS SUPABASE / POSTGRESQL
# Obtenha em: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-secreta-service-role-aqui
DATABASE_PASSWORD=sua-senha-aqui

# 2. PAGAMENTOS INFINITEPAY (PIX & CARTÃO DE CRÉDITO)
# Seu handle na InfinitePay (ex: seuharas ou harascloud)
VITE_INFINITEPAY_HANDLE=harascloud
VITE_INFINITEPAY_API_KEY=

# 3. NOTIFICAÇÕES WHATSAPP & E-MAIL
# API de WhatsApp (Evolution API / Z-API)
VITE_WHATSAPP_API_URL=
VITE_WHATSAPP_API_TOKEN=

# API de E-mails Transacionais (Resend)
VITE_RESEND_API_KEY=
